#!/bin/sh
# SPDX-License-Identifier: MIT
# N2660Emu: ARM Cortex-A7 Interactive Disassembler CLI

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$PROJECT_ROOT/target/release/disasm"

if [ ! -f "$BIN" ]; then
    cargo build --release --manifest-path "$PROJECT_ROOT/Cargo.toml" --bin disasm >/dev/null || exit 1
fi

exec "$BIN" "$@"
